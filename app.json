{
  "expo": {
    "name": "rti-app",
    "slug": "rti-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/Assets/RTIExpress1_square.png",
    "scheme": "rtiapp",
    "userInterfaceStyle": "automatic",

    "newArchEnabled": false,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/Assets/RTIExpress1_square.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.krishlabs.rtiapp"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/Assets/RTIExpress1_square.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/Assets/RTIExpress1_square.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them in posts."
        }
      ],
      "expo-localization"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "dacfb76f-59dc-486c-a693-90aa77ffe74f"
      }
    },

    "owner": "krish-labs",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/dacfb76f-59dc-486c-a693-90aa77ffe74f"
    }
  }
}